# Apo server — all secrets come from the environment, never from the repo.
# Copy to server/.env (gitignored) or export directly. Empty = provider off,
# the API answers honestly with 503 instead of inventing data.

PORT=8080
APO_DB_PATH=./apo.db

# Explanation + structuring model (OpenAI-compatible /chat/completions).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Vision OCR model for photos and scanned pages (must accept image input).
DEEPSEEK_VISION_MODEL=deepseek-flash

# Decision engine (TypeSafe System One).
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0

# Google Sign-In (audience check for ID tokens).
GOOGLE_CLIENT_ID=

# Play Billing server check (service-account JSON, one line).
GOOGLE_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE=com.apo.app

# Free solves per identity per day.
APO_FREE_DAILY=20
